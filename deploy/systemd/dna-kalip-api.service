[Unit]
Description=DnaKalip API
After=network.target

[Service]
WorkingDirectory=/var/www/dna-kalip-api
ExecStart=/usr/share/dotnet/dotnet /var/www/dna-kalip-api/DnaKalip.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dna-kalip-api
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
EnvironmentFile=-/etc/dna-kalip-api.env

[Install]
WantedBy=multi-user.target
